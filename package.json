{
  "name": "codex-desktop-app",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAI Codex Desktop App — Multi-Agent Command Center (macOS & Windows Desktop + Local Codex CLI Bridge)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "BROWSERSLIST_CONFIG=./.browserslistrc vite --port 5173",
    "server": "node server/app-server.mjs",
    "start": "node scripts/start-all.mjs",
    "build": "tsc -b && BROWSERSLIST_CONFIG=./.browserslistrc vite build",
    "build:site": "tsc -b && BROWSERSLIST_CONFIG=./.browserslistrc vite build --mode sites",
    "test:site": "node --test scripts/public-site.test.mjs",
    "preview": "vite preview --port 4173",
    "package": "node scripts/package-desktop.mjs",
    "package:mac": "node scripts/package-desktop.mjs --mac",
    "package:win": "node scripts/package-desktop.mjs --win",
    "icons": "node scripts/package-desktop.mjs --icons-only",
    "electron:dev": "ELECTRON_START_URL=http://localhost:5173 electron electron/main.cjs",
    "electron:start": "npm run build && electron electron/main.cjs",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.json",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.json"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
